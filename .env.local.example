# Supabase 프로젝트 설정 > API 에서 값을 복사해 .env.local 로 저장하세요.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...

# 서버 전용(절대 클라이언트로 노출 금지). 자녀 계정 프로비저닝, family 생성,
# '독서로' 자격증명 조회 등 서비스 역할이 필요한 관리 작업(app/api/**)에서만 사용합니다.
# 주의: API Keys 화면의 새 형식 secret key(sb_secret_...)는 GoTrue admin API에는 동작하지만
# PostgREST의 RLS 우회(테이블 insert/update 등)에는 role=service_role JWT가 필요해서 동작하지
# 않는다 — 반드시 "Legacy anon, service_role API keys" 탭의 service_role JWT를 사용할 것.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# 자녀 PIN -> 내부 인증용 비밀번호를 결정론적으로 파생시키는 서버 전용 salt.
# openssl rand -hex 32 등으로 생성해 넣으세요. 노출되면 PIN 추측 공격에 취약해집니다.
CHILD_AUTH_SECRET=change-me-to-a-long-random-string

# --- Azure OpenAI (질문 생성 + 감상문 생성, 6.5 하이브리드 모델 전략) ---
# Azure Portal > Azure OpenAI 리소스 > "키 및 엔드포인트"에서 확인. 서버 전용.
# 모델 배포는 Foundry 포털(ai.azure.com, 리소스 개요의 "Foundry 포털로 이동")의
# "모델 배포 > 기본 모델 배포"에서 만든다 — 클래식 Azure Portal에는 이 기능이 없다.
AZURE_OPENAI_ENDPOINT=https://xxxxxxxx.openai.azure.com
AZURE_OPENAI_API_KEY=xxxxxxxx
AZURE_OPENAI_API_VERSION=2024-10-21
# 대화 질문 생성 — 응답 속도 우선(저지연 경량 모델). gpt-4o-mini는 단종되어 후속
# 경량 모델(예: gpt-5.4-mini)로 대체 — 실제 배포 가능한 모델명은 시점마다 다를 수 있으니
# Foundry 포털의 모델 카탈로그에서 확인할 것. 신형 모델은 chat completions 호출 시
# max_tokens 대신 max_completion_tokens 파라미터를 요구한다(gpt-4o는 둘 다 허용).
AZURE_OPENAI_QUESTION_DEPLOYMENT=gpt-5.4-mini
# 최종 감상문 생성 — 세션당 1회, 문장 품질 우선(gpt-4o 이상 배포 이름)
AZURE_OPENAI_ESSAY_DEPLOYMENT=gpt-4o

# --- Azure AI Speech (아동 발화 STT, Standard S0) ---
AZURE_SPEECH_KEY=xxxxxxxx
AZURE_SPEECH_REGION=koreacentral

# --- Azure AI Document Intelligence (독서노트 OCR, Standard S0, Read 모델) ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://xxxxxxxx.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=xxxxxxxx

# --- 카카오 도서 검색 API (대화 질문 생성 컨텍스트용, 6.4 참조 — AI 내장 웹검색 대신 사용) ---
# Kakao Developers(developers.kakao.com) > 앱 생성 > 플랫폼 키 > REST API 키. src/lib/kakaoBook.ts에서 사용.
# 알라딘 Open API로 대체/병행 가능하지만(PRD 6.2) 현재는 카카오만 연동함.
KAKAO_REST_API_KEY=xxxxxxxx

# --- '독서로'(read365.edunet.net) 자동 연동 ---
# dokseoro_credentials 테이블에 저장하는 아이디/비밀번호를 암호화하는 서버 전용 키.
# openssl rand -hex 32 등으로 생성. CHILD_AUTH_SECRET과는 다른 값을 사용하세요.
DOKSEORO_CREDENTIALS_ENCRYPTION_KEY=change-me-to-a-long-random-string
